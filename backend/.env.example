# Postgres connection string (Supabase or any Postgres host both work) —
# required, there is no SQLite fallback anymore. Use the transaction-mode
# pooler connection string (port 6543 on Supabase) rather than the direct
# :5432 one, since get_db()/init_db() open a fresh connection per request.
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Gemini is the primary/free-tier AI provider (coach + help widget both try
# it first); Anthropic above is the fallback if this is unset or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
PUBLIC_APP_URL=http://localhost:5500
# Only needed if GOOGLE_REDIRECT_URI isn't set explicitly below — used to
# build the default callback URL (http://localhost:8000 in dev).
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5500
COOKIE_SECURE=false
# Two independent cohort gates for the investor directory — both must clear
# before it opens, not just one.
DIRECTORY_THRESHOLD=30
USER_THRESHOLD=20
LOG_LEVEL=INFO

# Comma-separated allowlist for /api/admin/* (approve/reject investor
# applications, view users/projects). Case-insensitive. Leave unset to
# disable the admin panel entirely.
ADMIN_EMAILS=

# Google Sign-In (OAuth2 authorization-code flow). Create an OAuth client
# in Google Cloud Console (APIs & Services > Credentials), add
# {PUBLIC_API_URL}/api/auth/google/callback as an authorized redirect URI.
# /api/auth/google/start returns a clean 503 until both are set — no broken
# redirect in the meantime.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub Sign-In (OAuth2 authorization-code flow). Create an OAuth App at
# github.com/settings/developers, set its "Authorization callback URL" to
# {PUBLIC_API_URL}/api/auth/github/callback. /api/auth/github/start returns
# a clean 503 until both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Cloudflare Turnstile (bot check on signup) — free, create a site at
# dash.cloudflare.com/?to=/:account/turnstile. Sitekey goes in the
# frontend's TURNSTILE_SITE_KEY constant (index.html); secret goes here.
# Signup skips the check entirely until this is set.
TURNSTILE_SECRET_KEY=
